# Copy this file to .env and fill in your own values.
# .env is gitignored and loaded automatically by server.py / space_weather_model.py.

# Cesium Ion access token used by cesium_map.html's 3D Moon globe.
# Get one at https://ion.cesium.com/tokens
CESIUM_ION_TOKEN=

# NASA API key used for DONKI (SEP/CME/FLR/GST) requests. Without this, the
# app falls back to the shared public DEMO_KEY, which is limited to ~30
# requests/hour and 50/day and is easily exhausted. Get a free, instant key
# at https://api.nasa.gov/
NASA_KEY=

# Secret required to call the protected /train, /ingest, and /validate
# endpoints on the Flask backend (space_weather_model.py). Set this to any
# strong random string you choose -- it is not issued by a third party.
TRAINING_API_KEY=

# Optional OpenAI key for the Luna chat assistant (/api/luna-chat).
# Without billing/quota the server uses keyless Pollinations.ai, then a
# LIPAS-data-aware local fallback. No signup required for Pollinations.
OPENAI_API_KEY=

# Optional model name for the keyless Pollinations path (default: openai).
LUNA_FREE_MODEL=openai
