# Copy to .env (gitignored). Loaded by server.py / space_weather_model.py.

# Cesium Ion token for the 3D Moon globe (https://ion.cesium.com/tokens)
CESIUM_ION_TOKEN=

# NASA key for DONKI. Without it the public DEMO_KEY is used (low rate limits).
# https://api.nasa.gov/
NASA_KEY=

# Shared secret for /train, /ingest, and /validate.
TRAINING_API_KEY=

# Optional. Enables Luna chat replies via an external API when set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LUNA_USE_LLM=1
