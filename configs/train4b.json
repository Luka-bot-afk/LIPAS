{
  "nickname": "LIPAS Train4b residual heads",
  "name": "lipas_train4b",
  "purpose": "T4b: residual targets for radiation+solar (Y_res = Y - persistence/physics proxy) after T4a.",
  "inherits": "train4a.json",
  "architecture": {
    "sequence_length": 72,
    "window_stride": 7,
    "lstm_units": [256, 128, 64],
    "dense_units": [256, 128],
    "dropout": [0.3, 0.25, 0.2, 0.3, 0.25],
    "l2_reg": 1e-4,
    "learning_rate": 0.0008,
    "clipnorm": 1.0,
    "use_attention": false,
    "use_last_timestep_skip": false,
    "physical_bounds": false,
    "loss_type": "channel_normalized_huber",
    "channel_priority": [4.0, 6.0, 1.0, 1.0, 1.5, 1.0],
    "boost_radiation_priority": true,
    "residual_channels": [0, 1],
    "residual_mode": "persistence_x"
  },
  "training": {
    "seed": 42,
    "epochs": 90,
    "batch_size": 64,
    "validation_split": 0.15,
    "test_split": 0.15,
    "storm_sample_weights": true,
    "recency_sample_weights": true,
    "cosine_decay": false,
    "early_stopping_patience": 16,
    "use_reduce_lr_on_plateau": true,
    "reduce_lr_patience": 7,
    "reduce_lr_factor": 0.5,
    "reduce_lr_min": 1e-6,
    "csv_pinned": "data/ingested_extended/train7_training_locked_y_ext_drivers.csv",
    "model_dir_default": "saved_model_train4b",
    "tf_determinism_best_effort": true
  },
  "hybrid_serve": {
    "start_blend": [0.5, 0.4, 0.15, 0.15, 0.20, 0.15]
  },
  "kaggle": {
    "dataset_slug": "lipas-train4",
    "kernel_slug": "lipas-train4b-kernel",
    "model_dir_on_kaggle": "/kaggle/working/saved_model_train4b"
  }
}
